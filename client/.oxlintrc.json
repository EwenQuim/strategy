{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["dist", ".tanstack", "src/routeTree.gen.ts", "generated"],
  "rules": {
    "no-shadow": "error",
    "no-restricted-properties": [
      "error",
      {
        "property": "useMemo",
        "message": "React Compiler handles memoization; use a plain expression instead."
      },
      {
        "property": "useCallback",
        "message": "React Compiler handles memoization; use a plain function instead."
      }
    ],
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "complexity": ["warn", 35],
        "max-lines": ["warn", 320]
      }
    },
    {
      "files": ["src/i18n/briefing.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useMemo", "useCallback"],
                "message": "React Compiler handles memoization; use plain expressions and functions instead."
              }
            ],
            "patterns": [
              {
                "group": ["**/generated/sdk.gen", "**/generated/sdk.gen.ts"],
                "message": "Import the generated SDK from src/api/ instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useMemo", "useCallback"],
                "message": "React Compiler handles memoization; use plain expressions and functions instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!./**",
                  "!../**",
                  "**/generated/sdk.gen",
                  "**/generated/sdk.gen.ts"
                ],
                "message": "Library modules must use relative imports and never the generated SDK."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!./**"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/engine/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!./**", "!../*.ts"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/engine/ai/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!./**",
                  "!../engine.ts",
                  "!../ai.ts",
                  "!../combat.ts",
                  "!../hex.ts",
                  "!../hellfire.ts",
                  "!../setup.ts",
                  "!../pawns/index.ts"
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
