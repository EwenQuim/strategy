{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["dist", ".tanstack", "src/routeTree.gen.ts", "generated"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "complexity": ["warn", 35],
        "max-lines": ["warn", 320]
      }
    },
    {
      "files": ["src/i18n/briefing.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/generated/sdk.gen", "**/generated/sdk.gen.ts"],
                "message": "Import the generated SDK from src/api/ instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!./**",
                  "!../**",
                  "**/generated/sdk.gen",
                  "**/generated/sdk.gen.ts"
                ],
                "message": "Library modules must use relative imports and never the generated SDK."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/bots/bot.ts",
        "src/bots/options.ts",
        "src/bots/targetPicker.ts",
        "src/bots/remoteText.ts",
        "src/bots/strategies/depthsearch.ts",
        "src/bots/strategies/random.ts",
        "src/bots/strategies/rules.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!../lib/**",
                  "!../../lib/**",
                  "!../bot.ts",
                  "!../options.ts",
                  "!../targetPicker.ts"
                ],
                "message": "Pure bot modules can only import the game library, Bot contract, search options and target pickers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!./**"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/engine/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!./**", "!../*.ts"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/engine/ai/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!./**",
                  "!../engine.ts",
                  "!../ai.ts",
                  "!../combat.ts",
                  "!../hex.ts",
                  "!../hellfire.ts",
                  "!../setup.ts",
                  "!../pawns/index.ts"
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
