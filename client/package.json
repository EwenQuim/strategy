{
  "name": "hexmate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint --deny-warnings && knip --treat-config-hints-as-errors",
    "sdk": "orval",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:pwa": "node --test tests/*.browser.ts",
    "test:pwa:smoke": "node --test --test-skip-pattern='^(Local mode|Campaign)' tests/*.browser.ts",
    "bench:ai": "node scripts/bench-ai.ts",
    "bench:commander": "node scripts/bench-commander.ts",
    "bench:learned": "node scripts/bench-learned.ts",
    "train:value": "node scripts/train-value.ts",
    "retrain:value": "node scripts/retrain-value.ts",
    "record:campaign": "node scripts/record-campaign.ts",
    "bench:web": "node scripts/bench-web.ts",
    "test:ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "@mistralai/mistralai": "^2.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/router-plugin": "^1.168.42",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "^6.41.0",
    "orval": "^8.41.0",
    "oxc-transform-react": "^0.153.0",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "fs-extra": "11.3.2"
  }
}
