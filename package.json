{
  "name": "hexmate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint --deny-warnings && knip --treat-config-hints-as-errors",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:pwa": "node --experimental-strip-types --test tests/*.browser.ts",
    "test:pwa:smoke": "node --experimental-strip-types --test --test-skip-pattern='^(Hits and misses|Local mode|Campaign)' tests/*.browser.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build",
    "prepare": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/router-plugin": "^1.168.40",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.37.0",
    "oxc-transform-react": "^0.145.0",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
